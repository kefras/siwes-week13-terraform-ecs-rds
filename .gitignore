# Terraform local caches and sensitive state / lock / plan artifacts
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfplan
*.tfplan.*
*.plan
*.plan.*
plan.json
plan-*.json
plan.txt
plan-*.txt
crash.log
crash.*.log
# Keep provider dependency locks: .terraform.lock.hcl is intentionally tracked.

# Local variable values and backend configuration; publish sanitized examples only.
*.tfvars
*.tfvars.json
*.tfvars.backup
!*.tfvars.example
!*.tfvars.json.example
backend.tf
backend.hcl
*.backend.hcl
*.auto.tfvars
*.auto.tfvars.json

# Credentials / environment / private keys. Never place real secrets in examples.
.env
.env.*
!.env.example
.aws/
.ssh/
.docker/
credentials
credentials.*
*credentials*.json
*service-account*.json
*accessKeys*.csv
*access-keys*.csv
.kube/
kubeconfig
*.kubeconfig
secrets/
secrets.*
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
.netrc
.npmrc

# Generated evidence, reports, diagrams, logs and image archives; sources stay tracked.
evidence/
artifacts/
dist/
build/
*.log
*.zip
*.tar
*.tar.gz
*.tgz
*.png
*.jpg
*.jpeg
*.pdf
*.docx
*.svg
!docs/assets/
!docs/assets/**
ci-enabled

